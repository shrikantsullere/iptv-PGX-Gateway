generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Dashboard_metrics {
  totalGatewayRevenue   Int
  todayVolume           Int
  activeMerchants       Int
  failedTransactionRate Int
  systemStatus          String
  lastUpdated           DateTime
  id                    String   @id @default(uuid())
}

model Merchants {
  merchantId       String   @id @default(uuid())
  companyName      String
  email            String
  phone            String
  subscriptionPlan String
  revenue          Int
  status           String
  country          String
  website          String
  apiKey           String
  createdAt        DateTime
  updatedAt        DateTime
}

model Transactions {
  transactionId   String   @id @default(uuid())
  merchantId      String
  merchantName    String
  customerName    String
  customerEmail   String
  amount          Int
  currency        String
  processor       String
  gatewayFee      Int
  transactionHash String
  walletAddress   String
  status          String
  paymentMethod   String
  createdAt       DateTime
  updatedAt       DateTime
}

model Revenues {
  revenueId           String   @id @default(uuid())
  processingVolume    Int
  gatewayFeeRevenue   Int
  subscriptionRevenue Int
  pendingSettlements  Int
  totalRevenue        Int
  month               String
  year                Int
  generatedAt         DateTime
}

model Settlements {
  settlementId     String   @id @default(uuid())
  merchantId       String
  merchantName     String
  amount           Int
  currency         String
  settlementMethod String
  settlementType   String
  status           String
  transactionHash  String
  bankReference    String
  initiatedAt      DateTime
  completedAt      DateTime
  createdAt        DateTime
  updatedAt        DateTime
}

model Wallets {
  walletId          String   @id @default(uuid())
  walletName        String
  walletAddress     String
  walletType        String
  network           String
  balanceUSD        Int
  balanceCrypto     Int
  assetSymbol       String
  status            String
  lastTransactionAt DateTime
  createdAt         DateTime
  updatedAt         DateTime
}

model Processor_dashboard {
  dashboardId    String   @id @default(uuid())
  total24hVolume Int
  activeNodes    Int
  totalNodes     Int
  approvalRate   Int
  criticalAlerts Int
  generatedAt    DateTime
}

model Processor_monitors {
  monitorId      String   @id @default(uuid())
  processorName  String
  status         String
  pingMs         Int
  loadPercentage Int
  successRate    Int
  lastCheckedAt  DateTime
  createdAt      DateTime
}

model Failover_events {
  eventId         String   @id @default(uuid())
  sourceProcessor String
  targetProcessor String
  triggerReason   String
  status          String
